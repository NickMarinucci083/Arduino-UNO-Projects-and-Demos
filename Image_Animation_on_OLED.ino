int xCounter = 0;
int yCounter = 0;
const int speed = 5; //The speed the turtle moves across the screen

void setup() {
  oled.begin(0x3c, true);
	oled.display();
  delay(2000);
  oled.clearDisplay();
  oled.setTextColor(SH110X_WHITE);
  oled.setTextSize(2);
  oled.setCursor(0, 0);
  oled.print("Thanks to:");
  oled.setTextSize(1);
  oled.setCursor(5, 40);
  oled.print("https://javl.github.");
  oled.setCursor(25, 50);
  oled.print("io/image2cpp/");
  oled.display();
  delay(2000);
  oled.clearDisplay();
}

void loop() {
		for (xCounter = 0; xCounter <=96; xCounter++) {
		oled.drawBitmap(xCounter, 0, turtle_facing_right, 32, 32, SH110X_WHITE);
		oled.display();
		delay(speed);
		oled.clearDisplay();
	}
	for (yCounter = 0; yCounter <=32; yCounter++) {
		oled.drawBitmap(96, yCounter, turtle_facing_down, 32, 32, SH110X_WHITE);
		oled.display();
		delay(speed);
		oled.clearDisplay();
	}
	for (xCounter = 96; xCounter >=0; xCounter--) {
		oled.drawBitmap(xCounter, 32, turtle_facing_left, 32, 32, SH110X_WHITE);
		oled.display();
		delay(speed);
		oled.clearDisplay();
	}
	for (yCounter = 32; yCounter >=0; yCounter--) {
		oled.drawBitmap(0, yCounter, turtle_facing_up, 32, 32, SH110X_WHITE);
		oled.display();
		delay(speed);
		oled.clearDisplay();
	}
}