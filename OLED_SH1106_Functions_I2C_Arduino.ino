int pixel = 0; //How many pixels light up on "star generation" mode
int scroll_counterx = 0; //How many lines to scroll horizontally on scroll function
int text_size = 0; //How many text sizes to go through
int blink_counter = 0; //How many times to blink text
int movepixel = 0; //Makes the pixels appear randomly
int contrast = 0; //The contrast setting

void setup()   {
  display.begin(I2C_Address, true); //Start I2C data communication with SH1106G OLED display chip
  display.display(); //Display adafruit splashscreen
  delay(3000);
  display.clearDisplay(); //Clear display
}


void loop() {
  //Print text to OLED
  display.setTextSize(2);                 // text size
  display.setTextColor(SH110X_WHITE);     // text color
  display.setCursor(0, 0);                // position to display (x, y)
  display.println("OLED");                // text to display
  display.println("Screen");
  display.println("Funtions");
  display.print("Demo");
  display.display();
  delay(3000);
  display.clearDisplay();
  display.setCursor(18, 18);
  display.print("1.3 Inch");
  display.setCursor(40, 35);
  display.print("OLED");
  display.invertDisplay(true);
  display.display();
  delay(3000);
  display.invertDisplay(false);
  display.clearDisplay();

  //Draw shapes onto OLED
  display.drawRect(10, 10, 108, 44, SH110X_WHITE); //(Cursor x, Cursor, Length, Height, Colour)
  display.display();                               //Rectangle
  delay(1000);
  display.fillRect(10, 10, 108, 44, SH110X_WHITE);
  display.display();
  delay(1000);
  display.clearDisplay();

  display.drawCircle(64, 32, 30, SH110X_WHITE);        //(Radius x, Radius y, Radius length, color)
  display.display();                                   //Circle
  delay(1000);
  display.fillCircle(64, 32, 30, SH110X_WHITE);
  display.display();
  delay(1000);
  display.clearDisplay();

  display.drawTriangle(64, 5, 5, 60, 123, 60, SH110X_WHITE); //(Point A x, Point A y, Point B x, Point B y, Point C x, Point C y, color)
  display.display();                                         //Triangle
  delay(1000);
  display.fillTriangle(64, 5, 5, 60, 123, 60, SH110X_WHITE);
  display.display();
  delay(1000);
  display.clearDisplay();

  display.drawRoundRect(10, 10, 108, 44, 20, SH110X_WHITE); //(Cursor x, Cursor, Length, Height, Corner roundness, Color)
  display.display();                                        //Round Rectangle
  delay(1000);
  display.fillRoundRect(10, 10, 108, 44, 20, SH110X_WHITE);
  display.display();
  delay(1000);
  display.clearDisplay();
  
  //Randomly light up individual pixels
  for (pixel = 0; pixel <= 1000; pixel++) {
  display.drawPixel (random(0, 128), random(0, 64), SH110X_WHITE); //(x, y, color)
  display.display();
  delay(2);
  }
  
  //Display custom image
  display.clearDisplay();
  display.drawBitmap(0, 0, image, 128, 64, SH110X_WHITE); //(Cursor position, Cursor position, image, image length, image height, colour)
  display.display();
  delay(500);
  display.invertDisplay(true); //Invert display pixel states
  delay(500);
  display.invertDisplay(false);
  delay(500);
  display.invertDisplay(true);
  delay(500);
  display.invertDisplay(false);
  delay(500);
  display.clearDisplay();

  //Change text size
  for (text_size = 0; text_size <=8; text_size++) {
  display.setTextSize(text_size);
  display.setCursor(0, 0);
  display.println("Text");
  display.print("Sizes");
  display.display();
  delay(500);
  display.clearDisplay();
  }
  for (text_size = 8; text_size >=0; text_size--) {
  display.setTextSize(text_size);
  display.setCursor(0, 0);
  display.println("Text");
  display.print("Sizes");
  display.display();
  delay(500);
  display.clearDisplay();
  }
  delay(500);

  //Scroll text
  display.setTextSize(1);
  display.setCursor((36+scroll_counterx), 25);
  display.print("Scrolling");
  display.setCursor((52+scroll_counterx), 35);
  display.print("Text");
  display.display();
  delay(500);
  for(scroll_counterx = 0; scroll_counterx <= 35; scroll_counterx++) { //Scroll to left
  display.setCursor((36+scroll_counterx), 25);
  display.print("Scrolling");
  display.setCursor((52+scroll_counterx), 35);
  display.print("Text");
  display.display();
  delay(5);
  display.clearDisplay();
  }
  delay(500);
  for(scroll_counterx = 35; scroll_counterx >= -35; scroll_counterx--) { //Scroll to right
  display.setCursor((36+scroll_counterx), 25);
  display.print("Scrolling");
  display.setCursor((52+scroll_counterx), 35);
  display.print("Text");
  display.display();
  delay(5);
  display.clearDisplay();
  }
  delay(500);
  for(scroll_counterx = -35; scroll_counterx <= 0; scroll_counterx++) { //Scroll back to middle
  display.setCursor((36+scroll_counterx), 25);
  display.print("Scrolling");
  display.setCursor((52+scroll_counterx), 35);
  display.print("Text");
  display.display();
  delay(5);
  display.clearDisplay();
  }
  delay(500);
  display.clearDisplay();

  //Blink text
  display.setTextSize(2);
  for (int blink_counter = 0; blink_counter <=5; blink_counter++) {
  display.clearDisplay();
  display.setTextColor(SH110X_WHITE);
  display.setCursor(15, 15);
  display.print("Blinking");
  display.setCursor(35, 35);
  display.print("Text!");
  display.display();
  delay(300);
  display.clearDisplay();
  display.setTextColor(SH110X_BLACK);
  display.setCursor(15, 15);
  display.print("Blinking");
  display.setCursor(35, 35);
  display.print("Text!");
  display.display();
  delay(300);
  }
  display.clearDisplay();

  //Fill display with text
  display.setTextSize(1);
  display.setTextColor(SH110X_WHITE);
  display.setCursor(0, 0);
  display.println("This is a 1.3 inch"); //Displays some imformation about OLED display module
  display.println("OLED display.");
  display.println("It's monochrome");
  display.println("meaning it is black");
  display.println("and white and uses");
  display.println("individually lit");
  display.println("pixels to show images");
  display.println("or text like you see.");
  display.display();
  delay(10000);
  display.clearDisplay();
  delay(100);

  //Make a pixel move on screen in a border
  display.drawRect(10, 10, 108, 44, SH110X_WHITE);
  display.display();
  delay(1000);
  for (movepixel = 0; movepixel <= 30; movepixel++) {
  display.drawPixel(random(10, 108), random(10, 54), SH110X_WHITE);
  display.drawRect(10, 10, 108, 44, SH110X_WHITE);
  display.display();
  delay(200);
  display.clearDisplay();
  }

  //Adjust contrast on OLED
  display.setTextSize(2);
  display.setCursor(5, 25);
  display.print("Brightness");
  display.invertDisplay(true);
  display.display();
  for (contrast = 255; contrast >= 0; contrast--){
    display.setContrast(contrast);
    delay(5);
  }
  delay(100);
  for (contrast = 0; contrast <= 255; contrast++){
    display.setContrast(contrast);
    delay(5);
  }
  delay(100);
  for (contrast = 255; contrast >= 0; contrast--){
    display.setContrast(contrast);
    delay(5);
  }
  delay(100);
  for (contrast = 0; contrast <= 255; contrast++){
    display.setContrast(contrast);
    delay(5);
  }
  delay(100);
  display.invertDisplay(false);
  display.display();
  display.clearDisplay();
  delay(1000);
}